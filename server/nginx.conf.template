limit_req_zone $binary_remote_addr zone=aetherloom_login:1m rate=10r/m;
server {
 listen __API_PORT__ ssl;
 server_name __DOMAIN__;
 ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 server_tokens off;
 client_max_body_size 8m;
 add_header Strict-Transport-Security "max-age=31536000" always;
 location = /health { proxy_pass http://127.0.0.1:8765; }
 location = /api/login { limit_req zone=aetherloom_login burst=5 nodelay; limit_req_status 429; proxy_pass http://127.0.0.1:8765; }
 location = /api/users { return 404; }
 location ^~ /api/users/ { return 404; }
 location = /api/audit { return 404; }
 location = /api/relay {
  proxy_pass http://127.0.0.1:8765;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_read_timeout 90s;
 }
 location /api/ { proxy_pass http://127.0.0.1:8765; proxy_read_timeout 120s; }
 location / { return 404; }
}
server {
 listen 443 ssl;
 server_name __DOMAIN__;
 ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 server_tokens off;
 location / { return 404; }
}
server {
 listen __PANEL_PORT__ ssl;
 server_name __DOMAIN__;
 ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 server_tokens off;
 access_log off;
 error_log /var/log/nginx/aetherloom-panel-error.log crit;
 client_max_body_size 8m;
 add_header Strict-Transport-Security "max-age=31536000" always;
 location = /__PANEL_PATH__ { return 302 /__PANEL_PATH__/; }
 location = /__PANEL_PATH__/api/login { limit_req zone=aetherloom_login burst=5 nodelay; limit_req_status 429; proxy_pass http://127.0.0.1:8765/api/login; }
 location ^~ /__PANEL_PATH__/ { proxy_pass http://127.0.0.1:8765/; proxy_read_timeout 120s; }
 location / { return 404; }
}
