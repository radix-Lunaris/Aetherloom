[Unit]
Description=Aetherloom panel entry manager
After=nginx.service
Requires=nginx.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/aetherloom/panel-agent/server/panel_agent.py
Restart=on-failure
RuntimeDirectory=aetherloom-panel
RuntimeDirectoryMode=0755
StateDirectory=aetherloom-panel
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
